# Production — browser calls same-origin /api/v1 (api-proxy.php → kinder-api).
# Avoids Hostinger CORS when WAF strips Access-Control-Allow-Origin on errors.
# VITE_API_URL stays absolute for /storage media URLs only.

VITE_API_BASE_URL=/api/v1
VITE_API_URL=https://kinder-api.softkatta.in
VITE_APP_NAME=Kindergarten

# Real-time (Laravel Reverb) — enable only when Reverb is deployed
VITE_REVERB_ENABLED=false
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=kinder-api.softkatta.in
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https
