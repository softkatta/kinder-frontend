# Copy to .env.development (local) or .env.production (build) and adjust values.

VITE_API_BASE_URL=/api/v1
VITE_API_URL=http://localhost:8000
VITE_APP_NAME=Little Stars Kindergarten

# Real-time (Laravel Reverb) — set true only when `php artisan reverb:start` is running
VITE_REVERB_ENABLED=false
VITE_REVERB_APP_KEY=kindergarten-key
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http 
