# Production SPA build — same-origin API via /api proxy on kinder.softkatta.in
# (public/api-proxy.php + .htaccess rewrite → kinder-api; avoids Hostinger CORS/403)

VITE_API_BASE_URL=/api/v1
VITE_API_URL=https://kinder-api.softkatta.in
VITE_APP_NAME=Kindergarten

# Real-time (Laravel Reverb) — enable only when Reverb is deployed
VITE_REVERB_ENABLED=false
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=kinder-api.softkatta.in
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https
